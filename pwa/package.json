{
  "name": "shotten-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "predev": "node scripts/check-npm.js",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "mobile:install": "bun install --cwd ../mobile",
    "mobile:dev": "bun run --cwd ../mobile dev",
    "mobile:start": "bun run --cwd ../mobile start",
    "mobile:android": "bun run --cwd ../mobile android",
    "mobile:ios": "bun run --cwd ../mobile ios",
    "lint": "eslint",
    "build:cf": "bun install --frozen-lockfile && bun scripts/generate-version.js && rm -rf .next .open-next && bash scripts/build-opennext.sh && bash scripts/prepare-pages.sh",
    "preview": "bun run build:cf && wrangler dev",
    "deploy": "bun run build:cf && wrangler deploy",
    "build:workers": "bun install && bun scripts/generate-version.js && bunx next build && bash scripts/build-opennext.sh",
    "preview:workers": "bun run build:workers && wrangler dev --config wrangler.workers.jsonc",
    "deploy:workers": "bun run build:workers && wrangler deploy --config wrangler.workers.jsonc"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "@tailwindcss/postcss": "^4.1.17",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.556.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-tooltip": "^5.30.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@eslint/eslintrc": "^3.3.6",
    "@mistralai/mistralai": "^1.11.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5",
    "wrangler": "^4.123.0"
  }
}
