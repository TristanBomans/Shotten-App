{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Separate Worker so the existing Pages project (`shotten-app`) can keep serving
  // shotten.taltiko.com until DNS is switched.
  "name": "derodeduiven",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://yrneeuvtfyeeoeucrbzp.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_uYPUzMACLAIGxn-JfJ3mug_W2mYGqy5",
    "NEXT_PUBLIC_APP_ICON_URL": "https://i.postimg.cc/9QwwdMHM/image.png"
  }
}
