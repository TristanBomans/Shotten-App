# Supabase (public — exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional tenant branding. Use a dedicated safe-zone image for Android masks.
NEXT_PUBLIC_APP_ICON_URL=https://example.com/icon.png
NEXT_PUBLIC_APP_MASKABLE_ICON_URL=https://example.com/icon-maskable.png

# Supabase service key (server-side only — used for write operations)
# Falls back to the anon key when not set. Required for player/match management.
SUPABASE_SERVICE_KEY=your-service-key

# Mistral AI (server-side only — used by the opponent-analysis endpoint)
MISTRAL_API_KEY=your-mistral-api-key

# Web Push (public — used by the PWA to subscribe)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
NEXT_PUBLIC_PUSH_WORKER_URL=https://shotten-push.example.workers.dev
