# Supabase (public — exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional tenant branding. Use a dedicated safe-zone image for Android masks.
NEXT_PUBLIC_APP_ICON_URL=https://example.com/icon.png
NEXT_PUBLIC_APP_MASKABLE_ICON_URL=https://example.com/icon-maskable.png

# Supabase service key (server-side only). Required: RLS only allows public
# reads, so every write goes through the API routes with this key.
SUPABASE_SERVICE_KEY=your-service-key

# OpenRouter (server-side and build-time — used for AI features)
OPENROUTER_API_KEY=your-openrouter-api-key

# Web Push (public — used by the PWA to subscribe). Must match VAPID_PUBLIC_KEY
# in shotten-backend-node, which holds the private key and sends the reminders.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
